# ==============================================================
# AI CONTENT OS – Environment (Variablennamen, keine echten Secrets)
# Kopieren nach .env – .env ist per .gitignore ausgeschlossen.
# ==============================================================

# --- Core -----------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://contentos:contentos@localhost:5432/contentos
# Kill Switch: bei "true" nimmt der Worker keine neuen Jobs an und publiziert nichts
KILL_SWITCH=false
# Globaler Review-Modus-Default für neue Projekte: SAFE | SEMI_AUTO | FULL_AUTO
DEFAULT_REVIEW_MODE=SAFE

# --- Storage --------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=content-os
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Provider-Modus --------------------------------------------
# mock  = alle Provider laufen offline & kostenlos (E2E-Test ohne Keys)
# live  = echte Provider gemäß Keys unten; fehlende Keys => Provider deaktiviert
PROVIDER_MODE=mock

# --- LLM Provider ----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Research / Search -----------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Image / Video ---------------------------------------------
FAL_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=

# --- Voice -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY wird auch für OpenAI-TTS genutzt

# --- Musik / SFX -----------------------------------------------
# Lokale, lizenzierte Musikbibliothek (Ordner mit .mp3/.wav + license.json)
MUSIC_LIBRARY_DIR=./assets/music
SFX_LIBRARY_DIR=./assets/sfx

# --- YouTube ---------------------------------------------------
# OAuth 2.0 Client (Google Cloud Console, YouTube Data API v3 + Analytics API aktiviert)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth/youtube/callback
# Refresh-Token je Kanal wird verschlüsselt in der DB gespeichert; Master-Key hier:
SECRETS_ENCRYPTION_KEY=

# --- Budgets (EUR) ---------------------------------------------
BUDGET_DAILY_EUR=20
BUDGET_MONTHLY_EUR=400
BUDGET_PER_VIDEO_SHORT_EUR=3
BUDGET_PER_VIDEO_LONGFORM_EUR=25

# --- Render ----------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_THREADS=4

# --- API / Web -------------------------------------------------
API_PORT=3000
API_TOKEN=change-me-local-only
