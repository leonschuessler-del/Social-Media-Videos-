{
  "name": "ai-content-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI Content OS – autonome Multi-Project Visual-Edutainment Content Engine (YouTube first).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E=1 vitest run --project e2e",
    "db:generate": "pnpm --filter @content-os/db generate",
    "db:migrate": "pnpm --filter @content-os/db migrate",
    "dev:api": "pnpm --filter @content-os/server dev:api",
    "dev:worker": "pnpm --filter @content-os/server dev:worker",
    "dev:web": "pnpm --filter @content-os/web dev",
    "cli": "pnpm --filter @content-os/cli start --",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
